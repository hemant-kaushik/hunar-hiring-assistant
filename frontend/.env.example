# Copy to .env.local for local overrides. No secrets belong in this file:
# anything prefixed VITE_ is inlined into the JS bundle and is public.

# Origin of the backend API.
# Leave empty in dev -- vite.config.ts proxies /api to localhost:8000.
# In production (Vercel) set this to the deployed backend URL, e.g.
# https://hunar-hiring-assistant.onrender.com
VITE_API_BASE_URL=
