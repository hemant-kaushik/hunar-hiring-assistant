# Copy to .env and fill in real values. NEVER commit .env.
# In production these are set as environment variables in the host dashboard
# (Render/Railway), not in a file.

# ---- Hunar Voice AI ----
# Issued by Hunar. Also used as the HMAC secret to verify inbound webhooks.
HUNAR_API_KEY=your-hunar-api-key-here
HUNAR_API_BASE_URL=https://api.voice.hunar.ai

# ---- Database ----
# Local dev default is SQLite; no value needed to run locally.
# Production (Neon): postgresql+asyncpg://user:pass@host/dbname
DATABASE_URL=sqlite+aiosqlite:///./hiring_assistant.db

# ---- Public URL of THIS backend ----
# Hunar posts call webhooks here, so it must be publicly reachable.
# Local dev: use an ngrok/cloudflared tunnel URL.
# Production: your Render/Railway service URL.
PUBLIC_BASE_URL=http://localhost:8000

# ---- CORS ----
# Comma-separated origins allowed to call this API (the React frontend).
CORS_ORIGINS=http://localhost:5173

# ---- Safety ----
# When true, calls are simulated and NO real phone call is placed.
DRY_RUN_CALLS=false

# OPTIONAL restriction on who can be dialled. Comma-separated E.164.
# Leave EMPTY (the normal setting) to call any candidate's number.
# Fill it in and only those numbers can be reached -- useful while testing,
# so a mistyped number cannot ring a stranger.
ALLOWED_TEST_NUMBERS=

# Assumed when someone types a phone number without a country code, so a
# recruiter can enter "9876543210" rather than "+919876543210".
DEFAULT_COUNTRY_CODE=+91

# ---- Calling hours ----
# Calls requested outside this window are QUEUED by the provider for the next
# permitted slot instead of being dialled, and show as "Queued" in the UI.
# Hunar allows 08:00-21:00 only and rejects the call outright outside that, so
# these values are clamped to it. A live call cannot be made outside those hours.
CALL_TIMEZONE=Asia/Kolkata
EARLIEST_CALL_TIME=08:00
LATEST_CALL_TIME=21:00
# The provider requires days alongside the times, so all three are always sent.
CALL_ALLOWED_DAYS=MON,TUE,WED,THU,FRI,SAT,SUN

# ---- Webhooks ----
# Reject inbound webhooks whose HMAC-SHA256 signature does not verify.
# Set to false ONLY to debug delivery locally; never in a deployed environment.
WEBHOOK_SIGNATURE_REQUIRED=true

# ---- Task 2 (People Search) - not required for Task 1 ----
# The demo dataset ships with no phone numbers of its own -- inventing them
# would put real strangers behind a "Reach out" button. Point this at a phone
# you control to make the sample profiles callable for a demo.
SAMPLE_CONTACT_PHONE=
PDL_API_KEY=
